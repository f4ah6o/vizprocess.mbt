import {
  "f4ah6o/vizprocess/pipe" @pipe,
  "f4ah6o/vizprocess/vizprocess" @vizprocess,
}

options(
  "is-main": true,
  link: {
    "js": {
      "exports": [ "manifest_to_svg", "version" ],
      "format": "esm",
      "use-js-builtin-string": true,
    },
    "wasm-gc": { "exports": [ "manifest_to_svg", "version" ] },
  },
  targets: { "main.mbt": [ "or", "wasm-gc", [ "or", "native", "js" ] ] },
)
