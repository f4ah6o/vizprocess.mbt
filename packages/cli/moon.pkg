import {
  "f4ah6o/vizprocess/pipe",
  "f4ah6o/vizprocess/pipe-duckdb" @pipe_duckdb,
  "f4ah6o/vizprocess/viz",
  "f4ah6o/vizprocess/vizprocess",
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

pkgtype(kind: "executable")

options(
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/lib -lduckdb",
    },
  },
  targets: {
    "main.mbt": [ "native" ],
    "wasm_stub.mbt": [ "or", "wasm", "wasm-gc", "js" ],
  },
)
