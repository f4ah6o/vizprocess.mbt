import {
  "f4ah6o/vizprocess/pipe" @pipe,
  "f4ah6o/vizprocess/pipe-duckdb" @pipe_duckdb,
  "f4ah6o/vizprocess/viz" @viz,
  "f4ah6o/vizprocess/vizprocess" @vizprocess,
  "moonbitlang/x/fs",
  "moonbitlang/x/sys",
}

options(
  "is-main": true,
  link: {
    "native": {
      "cc-link-flags": "-L/opt/homebrew/lib -Wl,-rpath,/opt/homebrew/lib -L/usr/local/lib -Wl,-rpath,/usr/local/lib -L/usr/lib -lduckdb",
    },
  },
)
